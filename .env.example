# SafeTwin 환경변수 예시
# 이 파일을 .env로 복사하여 실제 값으로 채우세요.
# cp .env.example .env

# ── Database ────────────────────────────────────────────────
# Docker 없이 로컬 실행 시: DB_HOST=localhost (기본값)
# Docker Compose 사용 시: docker-compose.yml이 DB_HOST=db 자동 설정
DB_USERNAME=safetwin
DB_PASSWORD=safetwin

# ── JWT (256비트 이상 랜덤 문자열) ───────────────────────────
JWT_SECRET=my-super-secret-key-for-safetwin-at-least-256-bits-long-please-change-this

# ── AWS S3 ──────────────────────────────────────────────────
AWS_ACCESS_KEY=your-aws-access-key-id
AWS_SECRET_KEY=your-aws-secret-access-key
AWS_S3_BUCKET=safetwin-bucket
AWS_REGION=ap-northeast-2

# ── Google Gemini AI ─────────────────────────────────────────
# Google AI Studio (aistudio.google.com) → Get API key
GEMINI_API_KEY=your-gemini-api-key

# ── Google OAuth2 ────────────────────────────────────────────
# Google Cloud Console → API & Services → OAuth 2.0 클라이언트 ID
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# ── 국세청 사업자번호 API ─────────────────────────────────────
# 공공데이터포털(data.go.kr) → 국세청_사업자등록정보 서비스 신청 후 발급
NTS_API_KEY=your-public-data-service-key

# ── 국가법령정보 API ──────────────────────────────────────────
# law.go.kr 오픈API 신청 후 발급 (https://www.law.go.kr/LSO/openApi.do)
LAW_API_KEY=your-law-go-kr-api-key

# ── 이메일 (선택) ───────────────────────────────────────────
MAIL_USERNAME=your-gmail@gmail.com
MAIL_PASSWORD=your-gmail-app-password

# ── CORS 추가 허용 도메인 (선택) ────────────────────────────
CORS_ALLOWED_ORIGINS=https://your-frontend-domain.com
